# Salin file ini menjadi .env lalu isi nilainya.
# Catatan: file .env TIDAK boleh di-commit ke git (sudah masuk .gitignore).

# Token bot Telegram dari @BotFather (WAJIB)
TELEGRAM_BOT_TOKEN=123456:AAE...GANTI_TOKEN_ASLI_KAMU

# Isi JSON kredensial Google Service Account (baris tunggal).
# Wajib jika menjalankan tanpa file modern-...json (misalnya di server).
# Jika file JSON ada di folder, file itu yang dipakai.
#GOOGLE_CREDENTIALS={"type": "service_account", "project_id": "...", ...}

# Daftar ID grup tambahan, pisahkan dengan koma (opsional).
#CHAT_IDS=-1001112223334,-1005556667778